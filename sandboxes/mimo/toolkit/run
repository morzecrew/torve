#!/bin/sh
# How this image invokes its harness (S-0063/D-1).
set -eu

: "${TORVE_PROMPT:?the engine names the prompt file}"
: "${TORVE_OUTPUT:?the engine names where the result goes}"

# This image used to refuse a brokered seat outright: torve had no mapping for
# the broker's two names here, so a seat told to go through the broker would
# have reached the provider directly instead — the leak S-0055/D-4 exists to
# prevent. There is nothing left to map (S-0064/D-8). One base URL and one named
# variable arrive whether a broker is in force or not, so the refusal became a
# deletion rather than an implementation.
#
# They reach mimo as a provider of its own, declared in configuration: mimo's
# built-in `openai` provider takes only the models in its catalog, so the base
# URL and key alone reached nothing ("Model not found"). `provider_config.py`
# says why and how.
MIMOCODE_CONFIG_CONTENT=$(python3 /opt/torve/provider_config.py)
export MIMOCODE_CONFIG_CONTENT

set -- mimo run --format json --dangerously-skip-permissions \
    --model "${TORVE_PROVIDER:-torve-provider}/$TORVE_MODEL"

if [ -n "${MIMO_AGENT:-}" ]; then
    set -- "$@" --agent "$MIMO_AGENT"
fi

# The door (S-0066/D-1), in `door.env` so the build's probe reads the same
# bytes the seat does. mimo has no flag for it: `--disable-root`, which this
# script passed from T-0381 on, is taken by neither 0.1.13 nor 0.1.15 — yargs
# printed the usage and exited, and the probe that should have caught it ran
# `--help`, which exits zero whatever else is on the line.
set -a
. /opt/torve/door.env
set +a

mkdir -p "$(dirname "$TORVE_OUTPUT")"

# The harness's own exit code, not `tee`'s: a pipeline reports its last
# command, so piping the harness through anything hands the engine a verdict
# belonging to the pipe — a failed attempt reading as a clean one. POSIX `sh`
# has no `pipefail`, so the status is carried across by hand, and the harness
# runs inside an `if` because `set -e` would otherwise kill the subshell
# before the status could be written.
rc=/tmp/torve-run.rc
echo 70 > "$rc"  # EX_SOFTWARE, if nothing overwrites it the pipe lied

{
    # The prompt on stdin, as the claude seat takes it: one argument is capped
    # at 128 KiB and a served prompt passes that ("Argument list too long",
    # bloomery night 10). `mimo run` reads a piped stdin as the message.
    if "$@" < "$TORVE_PROMPT"; then echo 0 > "$rc"; else echo $? > "$rc"; fi
} | tee "$TORVE_OUTPUT"

# mimo exits zero when the session itself fails — "Model not found" arrived as
# an `error` event and status 0 — and the engine reads zero as work to gate. A
# session that reported an error is a failed run whatever it exited with.
if [ "$(cat "$rc")" = 0 ] && grep -q '"type":"error"' "$TORVE_OUTPUT"; then
    echo 1 > "$rc"
fi

exit "$(cat "$rc")"
