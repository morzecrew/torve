#!/bin/sh
# How this image takes its equipment (S-0063/D-3).
#
# dsh's configuration is one list of plugin entries — `{id, name, config}`,
# where `name` is an npm package — and `--patch <file>` is how a list reaches
# it. So equipping dsh is writing one overlay, not composing flags: every kind
# lands in the same document, and torve never authors an entry it cannot know
# the shape of.
#
# A `plugin` item is installed first, because an entry naming a package dsh
# has not got is an entry that fails at boot. The install reads the mounted
# directory and never the network — the fetch already happened, host-side
# (S-0062/D-4).
set -eu

ARGS=/tmp/torve-equip.args
OVERLAY=/tmp/torve-equip.yml
: > "$ARGS"

[ -n "${TORVE_EQUIPMENT:-}" ] || exit 0
[ -f "$TORVE_EQUIPMENT/manifest.json" ] || exit 0

: > "$OVERLAY"

python3 - "$TORVE_EQUIPMENT/manifest.json" "$OVERLAY" <<'PY'
import json
import subprocess
import sys

manifest, overlay = sys.argv[1], sys.argv[2]

with open(manifest, encoding="utf-8") as handle:
    items = json.load(handle).get("items", [])

fragments = []

for item in items:
    if item["kind"] == "plugin":
        # pnpm from the mount, through dsh's own verb so the profile
        # directory is the one that gets it.
        subprocess.run(
            ["dsh", "plugin", "--profile", "headless", "add", item["path"]],
            check=True,
        )
        continue

    # Every other kind is a patch the operator wrote in dsh's own vocabulary:
    # an MCP server, a hook and an agent are all plugin entries here, and a
    # document torve invented would be a schema it does not know.
    with open(item["path"], encoding="utf-8") as handle:
        fragments.append(handle.read().rstrip("\n"))

if fragments:
    with open(overlay, "w", encoding="utf-8") as handle:
        handle.write("\n".join(fragments) + "\n")
PY

if [ -s "$OVERLAY" ]; then
    printf -- '--patch %s' "$OVERLAY" > "$ARGS"
fi
