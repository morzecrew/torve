# What dsh reads from its environment rather than from a patch, sourced by
# `equip`, `run` and `smoke` so the three agree (S-0122/D-10). A sourced file
# rather than three copies, for the reason `door.yml` is a file.
#
# Both homes are per attempt: `equip` empties and recreates them before it
# installs anything, so no profile, session or user-global `AGENTS.md` from an
# earlier attempt survives into this one. `equip` is also why they are here and
# not in `run`: `dsh plugin add` writes the profile under `$DSH_HOME`, and `run`
# has to boot the profile that install wrote. `DSH_AGENTS_HOME` is a directory
# and not an empty string, because dsh reads an empty value as unset and falls
# back to `~/.agents`. Both sit directly under `/tmp`, with no parent of their
# own: the build's smoke check runs as root, and a parent it left behind is one
# the sandbox's uid cannot create a home in — measured, `equip` died there.
DSH_HOME=/tmp/torve-dsh-home
DSH_AGENTS_HOME=/tmp/torve-dsh-agents
# The container is the sandbox, as it is for the claude seat's
# `bypassPermissions`: non-root, and its network is the runtime's to restrict
# (`runtime.network`, sealed to the broker's endpoint under S-0021). dsh's own
# permission mode governs its prompts, not the container's egress, so it is off. The base bundle reads this for both `sandbox-policy`'s
# mode and `approval`'s policy, and it is the one mode whose policy is `never`:
# headless has nobody to answer a prompt.
DSH_PERMISSION_MODE=danger-full-access
# Any non-empty value disables the OTLP exporter row, `0` included.
DSH_TELEMETRY_DISABLED=1
# `dsh plugin add` runs pnpm, and pnpm asks the npm registry whether it is out
# of date on every install. Behind a sealed broker that is one refused, counted
# destination per attempt that says nothing about the attempt. pnpm reads its
# own prefix for this: measured on the image's pnpm, `npm_config_` leaves the
# setting undefined and `pnpm_config_` sets it.
pnpm_config_update_notifier=false
export DSH_HOME DSH_AGENTS_HOME DSH_PERMISSION_MODE DSH_TELEMETRY_DISABLED pnpm_config_update_notifier
