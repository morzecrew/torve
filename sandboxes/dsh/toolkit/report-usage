#!/usr/bin/env node
// Replay the newest dsh session as the machine-readable trace the engine
// parses (S-0066/D-3): one line per billed request and per tool call, then the
// usage envelope last, in the shape parse_metadata reads (total_cost_usd /
// model keys, last JSON line wins). dsh emits none of it on stdout in headless;
// the session log carries it all. Cost is computed only when the operator
// supplies prices (USD per 1M tokens) via DSH_PRICE_IN / DSH_PRICE_OUT /
// DSH_PRICE_CACHE — self-reported regime, absent prices report null.
//
// The log is format v4 (dsh 0.1.7-alpha.1 and later), read against 0.2.1-rc.5:
// `$DSH_HOME/sessions/--<cwd>--/<session>/session.v4.jsonl`, zstd-compressed
// unless a profile says `compression: none`. Until rc.5 this read the v0 file
// under `~/.dsh`, which no 0.1.7+ dsh writes, so a bump would have reported no
// usage and no error.
const { execFileSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const LOGS = new Set(["session.v4.jsonl.zstd", "session.v4.jsonl"]);

function newestSession(root) {
  let best = null;
  const stack = [root];
  while (stack.length) {
    const dir = stack.pop();
    let entries;
    try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { continue; }
    for (const e of entries) {
      const p = path.join(dir, e.name);
      if (e.isDirectory()) stack.push(p);
      else if (LOGS.has(e.name)) {
        const m = fs.statSync(p).mtimeMs;
        if (!best || m > best.m) best = { p, m };
      }
    }
  }
  return best && best.p;
}

// `run` sources `dsh.env`, so the attempt's own home; dsh's default otherwise.
const home = process.env.DSH_HOME || path.join(process.env.HOME || "/tmp", ".dsh");
const file = newestSession(path.join(home, "sessions"));
if (!file) process.exit(0);

let text;
try {
  text = file.endsWith(".zstd")
    ? execFileSync("zstd", ["-dc", file], { maxBuffer: 1 << 28 }).toString()
    : fs.readFileSync(file, "utf8");
} catch {
  process.exit(0);
}

// The last usage chunk of an attempt's stream: a retried or failed request
// commits no message, but the tokens it was billed for are on its stream.
function lastUsage(records) {
  let usage = null;
  for (const record of Array.isArray(records) ? records : []) {
    const chunk = record && record.chunk;
    if (chunk && chunk.type === "usage" && chunk.usage) usage = chunk.usage;
  }
  return usage;
}

// `cacheCreationTokens` is the engine's name for what dsh calls
// `cacheWriteTokens`. `inputTokens` is the uncached part only, as on claude.
const totals = { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0, cacheCreationTokens: 0, reasoningTokens: 0 };
const toolCounts = {};
let model = null;
let requests = 0;
// The lines above the envelope, in the log's own order: the turn ordinal the
// engine records is the position of the turn-bearing lines in the stream.
const stream = [];

function bill(usage) {
  requests += 1;
  totals.inputTokens += usage.inputTokens || 0;
  totals.outputTokens += usage.outputTokens || 0;
  totals.cacheReadTokens += usage.cacheReadTokens || 0;
  totals.cacheCreationTokens += usage.cacheWriteTokens || 0;
  totals.reasoningTokens += usage.reasoningTokens || 0;
  // One request is one turn, with its usage as dsh wrote it: the burn profile
  // reads `outputTokens` off it and the context curve the input counts.
  // `reasoningTokens` rides along but is a breakdown — the cost math below
  // bills `outputTokens` as the complete output.
  stream.push({ type: "turn", usage });
}

for (const line of text.split("\n")) {
  if (!line.trim()) continue;
  let event;
  try { event = JSON.parse(line); } catch { continue; }
  const data = (event && event.data) || {};
  if (event.type === "assistant/message") {
    if (data.usage) bill(data.usage);
    const source = data.message && data.message.source;
    if (source && source.model) model = source.model;
  } else if (event.type === "assistant/attempt") {
    const usage = lastUsage(data.stream);
    if (usage) bill(usage);
  } else if (event.type === "tool/call" && typeof data.name === "string") {
    // The call as `tool/call` names it — the dispatched one, once — with its
    // name, which is what the engine's per-call facts are keyed by.
    toolCounts[data.name] = (toolCounts[data.name] || 0) + 1;
    // The arguments arrive as a JSON string; the engine classifies a call by
    // what it was given (the command, the path), so they go out as an object.
    let input;
    try { input = JSON.parse(data.arguments); } catch { input = undefined; }
    const call = { type: "tool-call", name: data.name };
    if (input && typeof input === "object" && !Array.isArray(input)) call.input = input;
    stream.push(call);
  }
}

// A session run's `--json` events carry each step and call (S-0122/D-11):
// `--envelope` prints the totals alone, or every call would be counted twice.
if (!process.argv.includes("--envelope")) {
  for (const event of stream) console.log(JSON.stringify(event));
}

const priceIn = parseFloat(process.env.DSH_PRICE_IN || "");
const priceOut = parseFloat(process.env.DSH_PRICE_OUT || "");
const priceCache = parseFloat(process.env.DSH_PRICE_CACHE || "");
let cost = null;
if (!Number.isNaN(priceIn) && !Number.isNaN(priceOut)) {
  // A cache write is billed as input: `inputTokens` is the uncached part only,
  // and neither DeepSeek nor ModelStudio prices a write apart from a miss.
  cost =
    ((totals.inputTokens + totals.cacheCreationTokens) * priceIn + totals.outputTokens * priceOut) /
    1e6;
  if (!Number.isNaN(priceCache)) cost += (totals.cacheReadTokens * priceCache) / 1e6;
  cost = Math.round(cost * 1e6) / 1e6;
}

console.log(JSON.stringify({ total_cost_usd: cost, model, usage: totals, requests, tool_counts: toolCounts }));
