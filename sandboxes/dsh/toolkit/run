#!/bin/sh
# How this image invokes its harness (S-0063/D-1).
#
# dsh takes three options in total — a profile, repeatable `--patch` overlays,
# and the task text as an argument. Everything else it does is configured by
# those overlays, which is why `equip` beside this file writes them rather than
# composing flags: dsh has one channel and claude has five.
set -eu

: "${TORVE_PROMPT:?the engine names the prompt file}"
: "${TORVE_OUTPUT:?the engine names where the result goes}"

# The homes, the permission mode and the telemetry switch: environment, not a
# patch, and the same file `equip` read before this, so the profile booted here
# is the one its plugin install wrote (S-0122/D-10).
. /opt/torve/dsh.env

set -- dsh --profile headless

# The model overlay `equip` rendered from the seat's `env` (S-0063/D-15). No
# model file is baked: a dsh model is a provider, a catalog entry and a default,
# and all three are values an operator chose rather than facts about the image.
if [ -s /tmp/torve-model.yml ]; then
    set -- "$@" --patch /tmp/torve-model.yml
fi

# Nothing here asks whether a broker is in force (S-0064/D-8). The rendered
# overlay reads TORVE_BASE_URL and the variable TORVE_API_KEY_ENV names, and
# both arrive with a value whichever way this seat reaches its provider.

# The door (S-0066/D-1). dsh walks the project root down to cwd collecting
# every `AGENTS.md` and `CLAUDE.md` it finds, and its skill plugin watches
# `.agents/skills` as well as the root the engine named. None of that is
# equipment, none of it is in the regime digest, and the `AGENTS.md` case is
# the worst of the four: it is torve's own projection arriving through a
# channel torve does not hash, per directory, so a seat reads rows governing
# files it only happens to look at.
#
# dsh has one configuration channel, so the door is an overlay like everything
# else — emptying the instruction-file candidate lists, and narrowing the skill
# roots to the one the engine named (S-0063/D-19). Both ids are entries the
# headless profile already carries: `--patch` configures an entry and cannot add
# one (S-0063/D-17). Neither a renamed entry nor a renamed key stops the boot —
# dsh warns about the first on stderr and drops the second without a word — so
# the build's smoke check reads the door back out of `--dump-config`.
#
# First of the three patches, because a later one wins: the seat's own
# equipment overlay may say more about an entry this one only narrows.
#
# The rows live in `door.yml` beside this file rather than in a heredoc here,
# so the build's smoke check patches the same bytes this does. It used to be a
# heredoc, and the copy that had no second reader is where a dropped key went
# unnoticed until three attempts had died on it.
DOOR=/tmp/torve-door.yml
sed "s|@EQUIP_ROOT@|${TORVE_EQUIP_ROOT:-.dsh/skills}|" /opt/torve/door.yml > "$DOOR"
set -- "$@" --patch "$DOOR"

# The tool set (S-0077), beside the door and for the same reason: a tool schema
# rides the system prompt into every request, so a declaration nothing calls is
# paid once per round trip. claude takes a flag for this and dsh takes a patch,
# because dsh has one channel; the entries and why each is switched off are in
# `tools.yml` beside this file, where the smoke check reads the same bytes.
set -- "$@" --patch /opt/torve/tools.yml

# System position (S-0073/D-8). dsh's channel is the deployment persona prefix:
# the order-0 section of the assembled prompt, above everything but the harness
# identity — so the rules are read before the contract the task text carries.
# One channel again, so it is a patch like the model and the door.
#
# The key is `personaPrefix`. It was `persona` through 0.1.2-rc.1, and
# 0.1.3-alpha.2 renamed it; dsh drops a key it does not know without a word, so
# a bump that kept the old key would have booted green with the engine's rules
# reaching no attempt. The smoke check reads the prefix back out of
# `--dump-config` for that reason.
#
# `--patch` REPLACES an entry's config rather than merging into it, which is
# why `persona.yml` restates the headless bundle's own sentence: measured on
# 0.2.1-rc.5, `@deepseek-ai/dsh-headless`'s `cordis.patch.yml` sets the prefix to
# exactly that sentence, and dropping it would take `{{model}}` with it. The
# `{{cwd}}` clause it used to carry is gone: 0.2.1 registers no such variable,
# and the working-directory service puts the directory in the runtime context.
#
# The prefix is a strict template: a complete `{{…}}` group in the staged text
# that names no registered variable fails the render rather than reaching the
# model. The rules the engine stages carry none.
#
# Before the equipment overlay, like the door above it: a later patch wins, and
# what a seat equips is the seat's own.
if [ -s "${TORVE_SYSTEM_PROMPT:-}" ]; then
    PERSONA=/tmp/torve-persona.yml
    {
        # The entry and the sentence, in a file the smoke check patches too.
        cat /opt/torve/persona.yml
        # Indented into the block scalar; the engine's file is the bytes.
        sed 's/^/      /' "$TORVE_SYSTEM_PROMPT"
    } > "$PERSONA"

    set -- "$@" --patch "$PERSONA"
fi

if [ -s /tmp/torve-equip.args ]; then
    eval "set -- \"\$@\" $(cat /tmp/torve-equip.args)"
fi

# The engine's session driver (S-0122/D-11): the run as NDJSON events, and a
# later turn continuing the session the first one opened. App arguments, so
# after every `--patch`.
if [ -n "${TORVE_JSON:-}" ]; then
    set -- "$@" --json
fi

if [ -n "${TORVE_SESSION_ID:-}" ]; then
    set -- "$@" --session-id "$TORVE_SESSION_ID"
fi

# The prompt last, as pieces: dsh takes its task from argv alone and joins the
# words with one space, and one argument is capped at 128 KiB — a served
# prompt passes that. Each piece ends at a space the join puts back. The `x`
# keeps a piece's trailing newlines, which `$(...)` would strip.
pieces=/tmp/torve-prompt.d
rm -rf "$pieces"
python3 /opt/torve/prompt_pieces.py "$TORVE_PROMPT" "$pieces"
for piece in "$pieces"/*; do
    text=$(cat "$piece"; printf x)
    set -- "$@" "${text%x}"
done

mkdir -p "$(dirname "$TORVE_OUTPUT")"

# The harness's own exit code, not `tee`'s: a pipeline reports its last
# command, so piping the harness through anything hands the engine a verdict
# belonging to the pipe — a failed attempt reading as a clean one. POSIX `sh`
# has no `pipefail`, so the status is carried across by hand, and the harness
# runs inside an `if` because `set -e` would otherwise kill the subshell
# before the status could be written.
rc=/tmp/torve-run.rc
echo 70 > "$rc"  # EX_SOFTWARE, if nothing overwrites it the pipe lied

{
    if "$@"; then echo 0 > "$rc"; else echo $? > "$rc"; fi

    # Last, because the last JSON line wins and this one carries the usage.
    # The events already carry each step and call, so a session run takes
    # the totals line alone.
    /opt/torve/report-usage ${TORVE_JSON:+--envelope} || true
} | tee "$TORVE_OUTPUT"

exit "$(cat "$rc")"
