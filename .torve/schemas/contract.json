{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iterations"
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "wallclock_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wallclock Minutes"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "InheritedDecision": {
      "additionalProperties": false,
      "description": "One row as a contract carries it (charter \u00a73; S-0054 S-0054/D-1): grade,\ntext and paths copied at mint and fingerprinted; `consequence` beside\nthem so the executor gets the reason, and `check` \u2014 a command whose\nexit code judges the row \u2014 which the runner appends to the battery as\na `decision:<id>` gate at `check_state`, with `check_twin` the test\nthat proves the check can fail (S-0054/D-4). A contract minted before\nS-0054 loads with the four defaults, which is the old behaviour.",
      "properties": {
        "check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        },
        "check_state": {
          "default": "shadow",
          "enum": [
            "shadow",
            "blocking"
          ],
          "title": "Check State",
          "type": "string"
        },
        "check_twin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Twin"
        },
        "consequence": {
          "default": "",
          "title": "Consequence",
          "type": "string"
        },
        "grade": {
          "enum": [
            "LOCKED",
            "ASSUMED",
            "OPEN"
          ],
          "title": "Grade",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "grade",
        "text"
      ],
      "title": "InheritedDecision",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "allow/deny globs, gitwildmatch semantics. deny wins over allow; an empty\nallow means unconstrained (S-0002/scope-in-detail).",
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        }
      },
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The task contract, `.torve/tasks/T-NNNN/contract.yaml` (S-0001/domain, \u00a76).\n\n`decisions` has no default on purpose: an empty list is legal but must be\nexplicit (S-0007/D-5), so `decisions-reported` can distinguish \"none apply\"\nfrom \"the field was forgotten\".",
  "properties": {
    "acceptance": {
      "items": {
        "type": "string"
      },
      "title": "Acceptance",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "character": {
      "anyOf": [
        {
          "enum": [
            "structural",
            "routine"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Character"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/InheritedDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "depends_on": {
      "items": {
        "type": "string"
      },
      "title": "Depends On",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "intent": {
      "default": "",
      "title": "Intent",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "phase": {
      "default": 0,
      "title": "Phase",
      "type": "integer"
    },
    "role": {
      "default": "implement",
      "enum": [
        "implement",
        "review",
        "revert",
        "draft"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "spec": {
      "anyOf": [
        {
          "pattern": "^S-\\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spec"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    },
    "tier": {
      "default": "executor",
      "enum": [
        "planner",
        "executor",
        "reviewer"
      ],
      "title": "Tier",
      "type": "string"
    },
    "tier_variant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier Variant"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "decisions"
  ],
  "title": "Task",
  "type": "object"
}
