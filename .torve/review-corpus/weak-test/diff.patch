diff --git a/src/durations.py b/src/durations.py
index bc31dcf..112980a 100644
--- a/src/durations.py
+++ b/src/durations.py
@@ -1,3 +1,4 @@
 def parse_duration(text: str) -> int:
-    """Seconds in a duration written like "90s"."""
-    return int(text.rstrip("s"))
+    """Seconds in a duration written like "90s" or "2m"."""
+    value, unit = int(text[:-1]), text[-1]
+    return value * 60 if unit == "m" else value
