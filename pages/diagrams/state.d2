direction: right

repo: "the repository — what SHOULD be" {
  style.fill: "#f5f0e8"
  rfcs: "rfcs/ — graded decisions,\nphasing"
  contracts: ".torve/tasks/<id>/contract.yaml"
  source: "source code"
  landings: "landing commits\n(Torve-Task trailers)"
}

record: "the record — what HAPPENED" {
  style.fill: "#e8f5ea"
  events: "append-only, typed events\none partition per repository"
}

carriers: "carriers — projections of the record" {
  style.fill: "#e8eef5"
  telemetry: "telemetry.jsonl\n(rendered from the event payload)"
  log: ".torve/tasks/<id>/log.yaml\n(written before each gate pass)"
  state: ".wt/<task>.state.json\n(the attempt loop's aggregate)"
  board: "the board\n(a fold, never stored)"
}

repo -> record: "minting places a contract\non a partition"
record -> carriers: "rendered"
record -> repo: "the landing commit\nis the engine's own"
carriers -> board: "nothing is edited;\nrebuilding is reading again"
