direction: right

git: "git — what SHOULD be" {
  style.fill: "#f5f0e8"
  rfcs: "rfcs/ decision tables\n+ phasing"
  contracts: ".torve/tasks/<id>/contract.yaml"
  logs: ".torve/tasks/<id>/log.yaml\n(divergence journal)"
  landings: "landing commits\n(Torve-Task trailers)"
}

store: "store — what HAPPENED" {
  style.fill: "#e8eef5"
  runs: "run states\n(leases, fences, history)"
  telemetry: "telemetry records\n(gates, agent, cost)"
  verdicts: "attempt verdict rows\n(RFC 0038)"
  traces: "durable traces\n(RFC 0039)"
  events: "escalation events"
}

projections: "read models" {
  context: "torve context"
  why: "why projection (0040)"
  board: "tracker board\n(GitHub issues/labels)"
}

git -> store: "one-way projection\n(D-27 LOCKED)"
store -> projections
git -> projections
projections -> board: "outbox relay\n(at-least-once)"
